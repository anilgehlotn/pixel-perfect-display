# Copy to .env.local for local development and fill in. Never commit real values.
# On Vercel, add these under Project Settings > Environment Variables instead.

# Public site URL, no trailing slash, e.g. https://skinfusion.in
# Used for absolute share-image links in Open Graph / Twitter tags.
VITE_SITE_URL=

# --- Checkout (server-only: never add a VITE_ prefix, these must not reach the browser) ---
# Payments (Razorpay Dashboard > Account & Settings > API Keys). Use test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks: URL {site}/api/payment-webhook, event payment.captured.
RAZORPAY_WEBHOOK_SECRET=
# Store backend where paid orders are created (Admin API, scopes write_orders, read_products).
# Domain without https://, the admin API access token, optional API version.
STORE_DOMAIN=
STORE_ADMIN_TOKEN=
STORE_API_VERSION=
