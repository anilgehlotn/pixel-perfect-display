# Copy to .env.local for local development and fill in. Never commit real values.
# On Vercel, add these under Project Settings > Environment Variables instead.

# Public site URL, no trailing slash, e.g. https://skinfusion.in
# Used for absolute share-image links in Open Graph / Twitter tags.
VITE_SITE_URL=

# Shopify store domain, without https://, e.g. your-store.myshopify.com
VITE_SHOPIFY_STORE_DOMAIN=

# Storefront API PUBLIC access token (Headless channel or custom app > Storefront API).
# This one is safe in the browser. NEVER put an Admin API token (shpat_...) here.
VITE_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Optional. Storefront API version, defaults to 2026-07.
VITE_SHOPIFY_API_VERSION=

# --- Customer accounts (Shopify Customer Account API). Server-only: never add a VITE_ prefix.
# Leave empty on your computer to use mock mode (sample customer; dev server only).
# Storefront domain used for discovery (.well-known endpoints), e.g. skinfusion.myshopify.com
# Falls back to VITE_SHOPIFY_STORE_DOMAIN when empty.
SHOPIFY_STORE_DOMAIN=
# Numeric shop ID (Shopify admin > Settings > Customer accounts > ... or the Headless
# channel's Customer Account API page). Only needed if SHOPIFY_STORE_DOMAIN is empty.
SHOPIFY_SHOP_ID=
# Client ID from Headless channel > your storefront > Customer Account API settings.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Only if Shopify gave you a client secret (confidential client). Public clients have none.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Public origin of this site, no trailing slash, e.g. https://skinfusion.in
# The sign-in callback is {APP_BASE_URL}/account/callback
APP_BASE_URL=
